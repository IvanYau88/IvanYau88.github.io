---
import '../styles.css';
import { Image } from 'astro:assets';
import { profile, skills, projects } from '../data';

const title = `${profile.name} | Data Analyst`;
const description = `${profile.name} - ${profile.tagline}. Portfolio of SQL, Tableau, Excel, and Python projects.`;
const ogImage = new URL(projects[0].image.src, Astro.site ?? Astro.url).href;
const pad = (n: number) => String(n).padStart(2, '0');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
      } catch (e) {}
    </script>
  </head>
  <body class="font-sans antialiased">
    <nav class="fixed inset-x-0 top-0 z-20 border-b border-line/60 bg-bg/80 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
        <a href="#top" class="font-semibold tracking-tight">{profile.name}</a>
        <div class="flex items-center gap-6 text-sm">
          <a href="#projects" class="text-muted transition hover:text-fg">Projects</a>
          <a href="#contact" class="text-muted transition hover:text-fg">Contact</a>
          <button id="theme" type="button" aria-label="Toggle dark mode" class="rounded-full border border-line p-2 text-muted transition hover:text-fg">
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </div>
      </div>
    </nav>

    <header id="top" class="relative isolate overflow-hidden">
      <div class="hero-bg absolute inset-0 -z-10"></div>
      <div class="mx-auto max-w-6xl px-6 pb-28 pt-40 sm:pb-40 sm:pt-56">
        <p class="reveal text-caption font-semibold uppercase text-accent">Data Analyst &middot; Allen, TX</p>
        <h1 class="reveal mt-6 text-hero font-extrabold" style="--d:80ms">{profile.name}</h1>
        <p class="reveal mt-8 max-w-2xl text-lead text-muted" style="--d:160ms">{profile.tagline}.</p>
        <ul class="reveal mt-8 flex flex-wrap gap-2" style="--d:240ms">
          {skills.map((s) => <li class="rounded-full border border-line bg-surface px-4 py-1.5 text-sm font-medium">{s}</li>)}
        </ul>
        <div class="reveal mt-12 flex flex-wrap gap-4" style="--d:320ms">
          <a href="#projects" class="rounded-full bg-accent px-7 py-3 font-semibold text-accent-fg transition hover:opacity-90">View projects</a>
          <a href="#contact" class="rounded-full border border-line px-7 py-3 font-semibold transition hover:border-accent hover:text-accent">Get in touch</a>
        </div>
      </div>
    </header>

    <main>
      <section id="projects" class="mx-auto max-w-6xl scroll-mt-16 px-6 py-24">
        <p class="reveal text-caption font-semibold uppercase text-accent">Selected work</p>
        <h2 class="reveal mt-3 text-display font-extrabold" style="--d:60ms">Projects</h2>
        <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((p, i) => (
            <article class="reveal group flex flex-col overflow-hidden rounded-3xl border border-line bg-surface shadow-sm transition duration-300 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-accent/10" style={`--d:${(i % 3) * 80}ms`}>
              <div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-bg">
                <Image src={p.image} alt={`${p.title} screenshot`} width={800} loading={i < 3 ? 'eager' : 'lazy'} class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105" />
              </div>
              <div class="flex flex-1 flex-col p-7">
                <span class="text-caption font-semibold uppercase text-muted">{pad(i + 1)}</span>
                <h3 class="mt-2 text-xl font-semibold tracking-tight">{p.title}</h3>
                <p class="mt-3 flex-1 leading-relaxed text-muted">{p.description}</p>
                <a href={p.link} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 font-semibold text-accent">
                  View Project <span aria-hidden="true" class="transition group-hover:translate-x-1">&rarr;</span><span class="sr-only"> ({p.title}, opens in new tab)</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer id="contact" class="scroll-mt-16 border-t border-line">
      <div class="mx-auto max-w-6xl px-6 py-24">
        <p class="reveal text-caption font-semibold uppercase text-accent">Contact</p>
        <h2 class="reveal mt-3 text-display font-extrabold" style="--d:60ms">Get in touch</h2>
        <ul class="reveal mt-10 space-y-3 text-lead" style="--d:120ms">
          <li><a class="transition hover:text-accent" href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a class="transition hover:text-accent" href={`tel:${profile.phone.replace(/[^\d]/g, '')}`}>{profile.phone}</a></li>
          <li class="text-muted">{profile.address}</li>
        </ul>
        <div class="mt-10 flex gap-3">
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="rounded-full border border-line p-3 text-muted transition hover:border-accent hover:text-accent">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          </a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="rounded-full border border-line p-3 text-muted transition hover:border-accent hover:text-accent">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.22.7.83.57A12 12 0 0 0 12 .3"/></svg>
          </a>
        </div>
        <p class="mt-16 text-sm text-muted">&copy; {new Date().getFullYear()} {profile.name}</p>
      </div>
    </footer>

    <script>
      document.getElementById('theme')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { threshold: 0.1 });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('in'));
    </script>
  </body>
</html>
